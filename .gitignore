# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# 环境与密钥（严禁提交）
.env
.env.*
!.env.example
*.key
*.pem
cookies*.json
storage_state*.json

# Office 临时文件
~$*.docx
~$*.xlsx
~$*.pptx

# 渲染 / 预览产物
.dsh-office-*/
*.tmp

# 大体积原始 HTML 快照（默认不提交；用 manifest.csv 记录的 URL + SHA256 追溯）
data/raw/html/*.html
*/data/raw/html/*.html

# 各项目运行中间产物（保留 outputs 下的正式交付物）
analysis/*/data/*.tmp
analysis/*/outputs/**/*.log

# P7 会话含用户原话，默认写到系统临时目录；仓库内旧目录也不纳入版本控制
analysis/p07_agent/outputs/sessions/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini
